# Kopieren nach .env und Werte anpassen: cp .env.example .env

# Datenbank
DB_USER=nodeguard
# Pflicht – langes, zufälliges Passwort nur aus Buchstaben und Ziffern
# (wird in die Datenbank-URL eingesetzt), z. B.: openssl rand -hex 24
DB_PASSWORD=
DB_DATABASE=nodeguard

# Port der Web-App auf dem Docker-Host (Standard: 80)
NODEGUARD_PORT=80

# Image-Tag des Servers (Standard: latest)
NODEGUARD_VERSION=latest
